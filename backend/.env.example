# ============================================================
# eReclamations CNPS CI — Variables d'environnement
# Copier ce fichier en .env et ajuster les valeurs
# ============================================================

# Base de données (valeurs Docker Compose par défaut)
DB_HOST=db
DB_PORT=5432
DB_NAME=db
DB_USER=db
DB_PASSWORD=db

# Sécurité JWT — CHANGER ABSOLUMENT EN PRODUCTION
JWT_SECRET=ereclamations_cnps_secret_2026_change_me_in_production

# Environnement (development | production)
APP_ENV=development

# CORS — Origine autorisée pour le frontend
CORS_ORIGIN=http://localhost:5173
